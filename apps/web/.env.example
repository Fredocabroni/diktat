# apps/web — public env vars (NEXT_PUBLIC_*)
#
# Every value in this file ships to the browser. Never put secrets here.
# Copy to apps/web/.env.local and fill in real values for local dev.

# Supabase project URL. REQUIRED.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — the browser auth key. REQUIRED.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for the tRPC API. Optional — defaults to http://localhost:4000.
NEXT_PUBLIC_API_URL=

# Enables the X (Twitter) OAuth button on /login when "true". Optional (default off).
NEXT_PUBLIC_X_OAUTH_ENABLED=

# VAPID public key (applicationServerKey for pushManager.subscribe).
# Optional — empty disables web-push and the settings UI shows a disabled state.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile site key for the /login CAPTCHA widget.
# REQUIRED whenever CAPTCHA is enabled in the Supabase Auth dashboard — email
# sign-up otherwise fails with "no captcha_token found". Leave empty only when
# CAPTCHA is disabled in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
