# Diktat — environment template. Copy to .env.local and fill in real values.

# --- Supabase ---
SUPABASE_URL_DEV=
SUPABASE_ANON_KEY_DEV=
SUPABASE_SERVICE_ROLE_KEY_DEV=
SUPABASE_PROJECT_REF_DEV=
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=
SUPABASE_PROJECT_REF_PROD=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Direct Postgres connection used by the workers LISTEN/NOTIFY client.
# Read from Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=

# --- Privy (custodial wallets) ---
# Workers listener provisions Solana custodial wallets when this flag is on
# AND both keys are non-empty. Until keys land, the listener logs a skip.
PRIVY_ENABLED=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Observability ---
AXIOM_TOKEN=
AXIOM_DATASET=

# --- LiveKit ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# --- Deploy targets ---
# TODO(vercel): VERCEL_TOKEN once Vercel account exists
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# TODO(railway): RAILWAY_TOKEN
RAILWAY_TOKEN=

# --- API runtime ---
# Number of trusted reverse-proxy hops in front of the API. Valid values:
# 1..10. MUST be set in production — server.ts asserts at boot and refuses
# to start if NODE_ENV=production but this is unset, because every IP-keyed
# rate-limit counter would otherwise collapse to the proxy IP and bypass
# the public-tier budgets. Confirm empirically: set it, curl /health,
# check the boot log's request.ip resolves to the real client IP, not the
# proxy.
#   - direct Railway edge → 1
#   - Railway + Cloudflare (or another CDN in front) → 2
#   - +1 per additional proxy layer
# UNSET in local dev (no proxy, request.ip = TCP peer = correct).
# DO NOT SET TO 0 — Fastify treats trustProxy:0 as `false`, silently
# bypassing the protection while passing the boot gate (PR #78 round-1
# security-reviewer MED). Unset and 0 mean the same thing semantically
# ("no trusted proxy"); only "unset" is a valid expression of that — the
# Zod schema rejects 0 with a clear error.
TRUSTED_PROXY_HOPS=

# Comma-separated CORS allow-list for the API. Default is local dev
# only. REQUIRED in production — server.ts asserts at boot and refuses
# to start if NODE_ENV is anything other than development/test AND
# WEB_ORIGINS declares only localhost-shaped origins (loopback literals:
# localhost / 127.0.0.1 / 0.0.0.0 / ::1). At least one real origin
# must be declared. A production deploy whose observable symptom is
# "nothing works" because every browser request fails CORS is a
# launch-day timebomb; this gate turns that silent failure into a loud
# boot refusal.
# Example: WEB_ORIGINS=https://diktat-web1.vercel.app,https://*-diktat.vercel.app
WEB_ORIGINS=

# Supabase JWT issuer URL. OPTIONAL in local dev / test; REQUIRED in
# production — server.ts asserts at boot and refuses to start if
# NODE_ENV is anything other than development/test and this is unset
# (or set to the empty string, which loadEnv coerces to undefined).
# Expected value: https://<project-ref>.supabase.co/auth/v1 (take
# <project-ref> from the Supabase dashboard URL). When set, context.ts
# passes it to jose's jwtVerify as the `issuer` claim check, so a token
# signed with the same SUPABASE_JWT_SECRET by a DIFFERENT Supabase
# project is rejected (prevents cross-project token acceptance if a
# second project is ever wired to the same shared secret).
SUPABASE_JWT_ISSUER=

# --- X / Twitter ---
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Telegram alerts (optional) ---
# Set BOTH to enable 🔴 error alerts. Unset = silent no-op. On Railway, set
# these on the diktat-api service (and, later, diktat-workers). Never ship to web.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
